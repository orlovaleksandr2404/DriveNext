<?xml version="1.0" encoding="utf-8"?><manifest xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:tools="http://schemas.android.com/tools">

<uses-permission android:name="android.permission.INTERNET" />
<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

<application
    android:allowBackup="true"
    android:dataExtractionRules="@xml/data_extraction_rules"
    android:fullBackupContent="@xml/backup_rules"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:supportsRtl="true"
    android:theme="@style/Theme.DriveNext">
    <activity
        android:name=".MainActivity"
        android:exported="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.DriveNext"
        android:windowSoftInputMode="adjustResize" />
    <activity
        android:name=".ui.NoInternetActivity"
        android:exported="false"
        android:windowSoftInputMode="adjustResize" />
    <activity
        android:name=".ui.OnboardingActivity"
        android:exported="false"
        android:windowSoftInputMode="adjustResize" />
    <activity
        android:name=".ui.SplashActivity"
        android:exported="true"
        android:windowSoftInputMode="adjustResize">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />

            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
    </activity>
    <activity
        android:name=".ui.AuthChoiceActivity"
        android:exported="false"
        android:screenOrientation="portrait" />
    <activity
        android:name=".ui.LoginActivity"
        android:exported="false"
        android:windowSoftInputMode="adjustResize"
        android:screenOrientation="portrait" />
    <activity
        android:name=".ui.RegisterStep1Activity"
        android:exported="false"
        android:windowSoftInputMode="adjustResize"
        android:screenOrientation="portrait" />
    <activity
        android:name=".ui.RegisterStep2Activity"
        android:exported="false"
        android:windowSoftInputMode="adjustResize"
        android:screenOrientation="portrait" />
    <activity
        android:name=".ui.RegisterStep3Activity"
        android:exported="false"
        android:windowSoftInputMode="adjustResize"
        android:screenOrientation="portrait" />
    <activity
        android:name=".ui.RegisterSuccessActivity"
        android:exported="false"
        android:screenOrientation="portrait" />
    <provider
        android:name="androidx.core.content.FileProvider"
        android:authorities="${applicationId}.fileprovider"
        android:exported="false"
        android:grantUriPermissions="true">
        <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
    </provider>
    <activity
        android:name=".ui.SearchResultsActivity"
        android:exported="false"
        android:screenOrientation="portrait"
        android:windowSoftInputMode="adjustResize" />

    <activity
        android:name=".ui.ProfileActivity"
        android:exported="false"
        android:screenOrientation="portrait"
        android:windowSoftInputMode="adjustResize" />
</application>

</manifest>